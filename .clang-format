---
# Note: we deliberately do NOT set `Language:`. Auto-detecting by file
# extension keeps the config working across clang-format versions (the
# `Language: C` scalar was only added in clang-format 23).
BasedOnStyle:  LLVM
IndentWidth:   4
TabWidth:      4
UseTab:        Never
ColumnLimit:   80
BreakBeforeBraces: Allman
# Keep the original include order. Reordering <net/if.h> ahead of
# <linux/if.h> trips a IFF_* enumerator redeclaration on Linux, so the
# project's existing order must be preserved.
SortIncludes: false
...
